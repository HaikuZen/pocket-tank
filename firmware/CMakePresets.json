{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "fnk0115",
      "displayName": "Freenove FNK0115 (4.3 / 5.0 IPS)",
      "binaryDir": "${sourceDir}/build-fnk0115",
      "cacheVariables": {
        "IDF_TARGET": "esp32s3",
        "SDKCONFIG": "${sourceDir}/build-fnk0115/sdkconfig",
        "SDKCONFIG_DEFAULTS": "sdkconfig.defaults;sdkconfig.fnk0115"
      },
      "vendor": {
        "espressif/vscode-esp-idf": {
          "settings": [
            {
              "type": "flashBaudRate",
              "value": "460800"
            },
            {
              "type": "monitorBaudRate",
              "value": "115200"
            }
          ]
        }
      }
    },
